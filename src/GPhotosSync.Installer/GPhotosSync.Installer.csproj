<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
    <AssemblyName>GPhotosSync_Setup</AssemblyName>
    <RootNamespace>GPhotosSync.Installer</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <Version>1.0.7</Version>
    <Product>Instalátor Google Photos Sync</Product>
    <Description>Instalační program aplikace Google Photos Sync pro Windows</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="payload.zip" LogicalName="GPhotosSync.Installer.payload.zip" Condition="Exists('payload.zip')" />
  </ItemGroup>

</Project>
